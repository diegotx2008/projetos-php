{% extends 'base.html.twig' %}

{% block title %}Dashboard - Financeiro{% endblock %}

{% block content %}
<h2 class="mb-4">Painel de Acompanhamento</h2>

<!-- Indicadores Globais -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body">
                <h6>Total Arrecadação</h6>
                <h3>R$ {{ totais.previsto|number_format(2, ',', '.') }}</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body">
                <h6>Total Arrecadado</h6>
                <h3>R$ {{ totais.pago|number_format(2, ',', '.') }}</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger shadow-sm">
            <div class="card-body">
                <h6>Total Pendente</h6>
                <h3>R$ {{ totais.pendente|number_format(2, ',', '.') }}</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-dark bg-warning shadow-sm">
            <div class="card-body">
                <h6>Confirmados</h6>
                <h3>{{ participantes|length }} Pessoas</h3>
            </div>
        </div>
    </div>
</div>

<!-- Tabela de Acompanhamento da Família -->
<div class="card shadow-sm">
    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
        <span>Situação Financeira por Integrante</span>
        <a href="lancamento.php" class="btn btn-sm btn-success">+ Novo Lançamento</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Patriarca/Matriarca</th>
                        <th>Meta (R$)</th>
                        <th>Pago (R$)</th>
                        <th>Pendente (R$)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in participantes %}
                    <tr>
                        <td class="fw-bold">{{ p.nome }}</td>
                        <td>{{ p.patriarca }}</td>
                        <td>R$ {{ p.valor_total|number_format(2, ',', '.') }}</td>
                        <td class="text-success fw-bold">R$ {{ p.pago|number_format(2, ',', '.') }}</td>
                        <td class="text-danger fw-bold">R$ {{ p.pendente|number_format(2, ',', '.') }}</td>
                        <td>
                            {% if p.pendente == 0 %}
                                <span class="badge bg-success">Quitado</span>
                            {% elseif p.pago == 0 %}
                                <span class="badge bg-danger">Em Aberto</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">Parcial</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}