{% extends 'base.html.twig' %}

{% block title %}Novo Lançamento{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white fw-bold">
                Lançar Parcela / Pagamento
            </div>
            <div class="card-body">
                {% if sucesso %}
                    <div class="alert alert-success">{{ sucesso }}</div>
                {% endif %}
                <form method="POST" action="lancamento.php">
                    <div class="mb-3">
                        <label class="form-label">Selecione o Integrante</label>
                        <select name="participante_id" class="form-select" required>
                            <option value="">-- Escolha um integrante --</option>
                            {% for p in participantes %}
                                <option value="{{ p.id }}">{{ p.nome }} ({{ p.patriarca }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Valor Pago (R$)</label>
                        <input type="number" step="0.01" name="valor" class="form-control" placeholder="88.00" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Data do Pagamento</label>
                        <input type="date" name="data_pagamento" class="form-control" value="{{ "now"|date("Y-m-m") }}" required>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="dashboard.php" class="btn btn-secondary">Voltar</a>
                        <button type="submit" class="btn btn-success">Registrar Pagamento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}