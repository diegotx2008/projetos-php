{% extends 'layouts/base.html.twig' %}

{% block title %}Catálogo de Filmes - Geek Central{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-info"><i class="bi bi-film"></i> Catálogo de Filmes</h2>
</div>

<!-- Painel de Filtros -->
<div class="card card-geek mb-4 p-3">
    <form method="GET" action="/filmes" class="row g-3">
        <div class="col-md-4 col-12">
            <input type="text" name="busca" class="form-control" placeholder="Buscar por Nome ou Ano..." value="{{ filters.busca }}">
        </div>
        <div class="col-md-3 col-6">
            <select name="genero_id" class="form-select">
                <option value="">Todos os Gêneros</option>
                {% for g in generos %}
                    <option value="{{ g.id }}" {{ filters.genero_id == g.id ? 'selected' : '' }}>{{ g.nome }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2 col-6">
            <input type="number" step="0.1" name="nota_imdb" class="form-control" placeholder="Nota IMDb Mín." value="{{ filters.nota_imdb }}">
        </div>
        <div class="col-md-2 col-6">
            <select name="per_page" class="form-select" onchange="this.form.submit()">
                <option value="10" {{ pagination.per_page == 10 ? 'selected' : '' }}>10 por pág</option>
                <option value="25" {{ pagination.per_page == 25 ? 'selected' : '' }}>25 por pág</option>
                <option value="50" {{ pagination.per_page == 50 ? 'selected' : '' }}>50 por pág</option>
            </select>
        </div>
        <div class="col-md-1 col-6">
            <button type="submit" class="btn btn-info w-100"><i class="bi bi-search"></i></button>
        </div>
    </form>
</div>

<!-- Mídias da API (Resultados de Busca Externa) -->
{% if filmes_api is not empty %}
    <h4 class="text-warning mb-3"><i class="bi bi-cloud-download"></i> Encontrados na API TMDB:</h4>
    <div class="row row-cols-2 row-cols-md-5 g-3 mb-5">
        {% for filme in filmes_api %}
            <div class="col">
                <div class="card card-geek h-100">
                    <img src="{{ filme.capa_url }}" class="card-img-top poster-img" alt="{{ filme.titulo }}">
                    <div class="card-body d-flex flex-column justify-content-between p-2">
                        <h6 class="card-title text-truncate mb-1">{{ filme.titulo }}</h6>
                        <small class="text-muted">{{ filme.ano }} | IMDb: {{ filme.nota_imdb }}</small>
                        <button class="btn btn-outline-info btn-sm mt-2" 
                                onclick="openAddModal({{ filme.id }}, '{{ filme.titulo|e('js') }}')">
                            <i class="bi bi-plus-circle"></i> Adicionar
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<!-- Mídias Locais Salvas -->
<h4 class="text-white mb-3"><i class="bi bi-collection-play"></i> Meus Filmes Salvos:</h4>
<div class="row row-cols-2 row-cols-md-5 g-3">
    {% for filme in filmes_salvos %}
        <div class="col">
            <div class="card card-geek h-100">
                <img src="{{ filme.capa_url }}" class="card-img-top poster-img" alt="{{ filme.titulo }}">
                <div class="card-body p-2">
                    <span class="badge bg-primary mb-1">Filme</span>
                    <h6 class="card-title text-truncate mb-1">{{ filme.titulo }}</h6>
                    <small class="text-muted d-block">{{ filme.ano_lancamento }} | {{ filme.genero_nome }}</small>
                    
                    <!-- Avaliação do Usuário -->
                    <div class="star-rating my-1">
                        {% for i in 1..5 %}
                            <i class="bi bi-star{% if i <= (filme.nota_usuario / 2) %}-fill{% endif %}"></i>
                        {% endfor %}
                    </div>
                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> IMDb: {{ filme.nota_imdb }}</span>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12"><div class="alert alert-secondary">Nenhum filme encontrado na sua biblioteca local.</div></div>
    {% endfor %}
</div>

<!-- Modal Bootstrap de Adicionar à Lista -->
<div class="modal fade" id="modalAddLista" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <form action="/filmes/salvar" method="POST">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info" id="modalTitulo">Adicionar à Lista</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="tmdb_id" id="modal_tmdb_id">
                    
                    <div class="mb-3">
                        <label class="form-label">Escolha a Lista:</label>
                        <select name="lista_id" class="form-select" required>
                            {% for l in listas %}
                                <option value="{{ l.id }}">{{ l.nome }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gênero do Filme:</label>
                        <select name="genero_id" class="form-select" required>
                            {% for g in generos %}
                                <option value="{{ g.id }}">{{ g.nome }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sua Nota (1 a 10):</label>
                        <input type="number" min="1" max="10" name="nota_usuario" class="form-control" value="8" required>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info">Salvar no Banco</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function openAddModal(tmdbId, titulo) {
    document.getElementById('modal_tmdb_id').value = tmdbId;
    document.getElementById('modalTitulo').innerText = 'Adicionar: ' + titulo;
    var modal = new bootstrap.Modal(document.getElementById('modalAddLista'));
    modal.show();
}
</script>
{% endblock %}