<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Geek Central - Filmes, Séries e Animes{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #0b0e14; color: #e2e8f0; }
        .navbar { background-color: #151c28 !important; border-bottom: 1px solid #2d3748; }
        .card-geek { background-color: #1a202c; border: 1px solid #2d3748; transition: transform 0.2s; }
        .card-geek:hover { transform: translateY(-5px); border-color: #00f2fe; }
        .poster-img { height: 320px; object-fit: cover; }
        .star-rating { color: #ffc107; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold text-info" href="/"><i class="bi bi-controller"></i> GEEK<span class="text-white">CENTRAL</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/filmes"><i class="bi bi-film"></i> Filmes</a></li>
                    <li class="nav-item"><a class="nav-link" href="/series"><i class="bi bi-tv"></i> Séries</a></li>
                    <li class="nav-item"><a class="nav-link" href="/animes"><i class="bi bi-play-btn"></i> Animes</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/admin/generos">Gêneros</a></li>
                            <li><a class="dropdown-item" href="/admin/listas">Minhas Listas</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <span class="me-3 text-secondary"><i class="bi bi-person-circle"></i> {{ session.user_nome }}</span>
                    <a href="/logout" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right"></i> Sair</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        {% block content %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>